  "techniques": [
    {
      "key": "ready-stance",
      "name": {"en": "Ready Stance", "ko": "기본 준비자세", "romanized": "Gibon Junbi Jase"},
      "category": "stance",
      "video_timestamp": 161,
      "video_timestamp_end": 216,
      "tips": [
        {"text": "Begin with Moaseogi: stand and move your left foot about a foot's length to your left", "timestamp": 166},
        {"text": "Breathe in, open your fists and raise them from the lower abdomen up to the solar plexus", "timestamp": 175},
        {"text": "Breathe out, then lower your fists back to the lower abdomen", "timestamp": 180},
        {"text": "Your face, torso, and lower body should be balanced along the center line", "timestamp": 185},
        {"text": "Your weight should be placed evenly on both feet", "timestamp": 193},
        {"text": "Both elbows should be bent like the internal angles of a hexagram", "timestamp": 196},
        {"text": "Your fists should be placed apart about a fist's length", "timestamp": 200},
        {"text": "Retain 30% of your breath in the lower abdomen once the preparatory move is complete", "timestamp": 206},
        {"text": "Be careful not to raise or tense your shoulders", "timestamp": 211}
      ]
    },
    {
      "key": "low-block",
      "name": {"en": "Low Block", "ko": "아래막기", "romanized": "Arae Makgi"},
      "category": "block",
      "video_timestamp": 216,
      "video_timestamp_end": 253,
      "tips": [
        {"text": "Block an opponent's attack towards the lower body with your outer wrist", "timestamp": 216},
        {"text": "The blocking arm's elbow should position your fist above your knees about two fists' length", "timestamp": 227},
        {"text": "The wrist on the supporting arm should be straightened so the back of your hand faces down", "timestamp": 235},
        {"text": "The wrist touches above the waist; the torso and arm should spin simultaneously", "timestamp": 241},
        {"text": "The blocking arm's elbow should not move in a straight line", "timestamp": 244}
      ]
    },
    {
      "key": "middle-punch",
      "name": {"en": "Middle Punch", "ko": "몸통지르기", "romanized": "Momtong Jireugi"},
      "category": "strike",
      "video_timestamp": 253,
      "video_timestamp_end": 305,
      "tips": [
        {"text": "Thrust with the fist to attack an opponent's torso", "timestamp": 253},
        {"text": "The thrusting arm should be straightened and your fist should form a straight line", "timestamp": 260},
        {"text": "The supporting arm wrist should be straightened with the back of your hand facing down", "timestamp": 265},
        {"text": "The thrusting arm should move straight forward", "timestamp": 278},
        {"text": "The supporting arm should be pulled back slightly, brushing your waist", "timestamp": 288},
        {"text": "Do not pull the supporting arm back excessively, pulling the shoulder along", "timestamp": 291},
        {"text": "The spin of the thrusting wrist should complete once your fist makes contact", "timestamp": 297},
        {"text": "Keep a straight line when punching a target with your fist", "timestamp": 305}
      ]
    },
    {
      "key": "inward-middle-block",
      "name": {"en": "Inward Middle Block", "ko": "몸통안막기", "romanized": "Momtong An Makgi"},
      "category": "block",
      "video_timestamp": 305,
      "video_timestamp_end": 344,
      "tips": [
        {"text": "Defend from an opponent's outside attack using the outer wrist", "timestamp": 305},
        {"text": "The outer wrist should be level with the solar plexus", "timestamp": 311},
        {"text": "The location of your fist should coincide with the center line", "timestamp": 315},
        {"text": "The beginning position is about a fist's length above the shoulder", "timestamp": 328},
        {"text": "The elbow of your defending arm should pull towards the torso", "timestamp": 334},
        {"text": "The elbow of the supporting arm should be pulled slightly", "timestamp": 339}
      ]
    },
    {
      "key": "upper-block",
      "name": {"en": "Upper Block", "ko": "올려막기", "romanized": "Ollyeo Makgi"},
      "category": "block",
      "video_timestamp": 344,
      "video_timestamp_end": 376,
      "tips": [
        {"text": "Protect from an opponent's attack towards the face by raising your outer wrist", "timestamp": 344},
        {"text": "Cross your arms in front and protect by raising them upwards", "timestamp": 354},
        {"text": "The fist on the defending arm should be above the elbow", "timestamp": 361},
        {"text": "Space about the size of a fist between the back of the wrist and the forehead", "timestamp": 364},
        {"text": "Leave space between the head and arms when seen from the front", "timestamp": 371},
        {"text": "Be careful not to raise your arm excessively", "timestamp": 370}
      ]
    },
    {
      "key": "front-kick",
      "name": {"en": "Front Kick", "ko": "앞차기", "romanized": "Ap Chagi"},
      "category": "kick",
      "video_timestamp": 376,
      "video_timestamp_end": 409,
      "tips": [
        {"text": "The kicking leg starts on top of the knee of your supporting leg", "timestamp": 380},
        {"text": "The forward kicking leg should be bent so your front sole touches the ground", "timestamp": 394},
        {"text": "Train this technique using coordination of the upper and lower body", "timestamp": 397}
      ]
    },
    {
      "key": "parallel-stance",
      "name": {"en": "Parallel Stance", "ko": "나란히서기", "romanized": "Naranhi Seogi"},
      "category": "stance",
      "video_timestamp": 409,
      "video_timestamp_end": 427,
      "tips": [
        {"text": "Keep your feet parallel so that the back of the feet align naturally as if stopping after walking", "timestamp": 409},
        {"text": "The center of your body should be placed in between your feet, chest relaxed", "timestamp": 424}
      ]
    },
    {
      "key": "walking-stance",
      "name": {"en": "Walking Stance", "ko": "앞서기", "romanized": "Ap Seogi"},
      "category": "stance",
      "video_timestamp": 427,
      "video_timestamp_end": 449,
      "tips": [
        {"text": "The distance between feet is about one step; center of body placed between feet", "timestamp": 428},
        {"text": "Body should stand straight; back of the foot blade on the front foot and inner heel on hind foot on the same line", "timestamp": 434},
        {"text": "The sole of the hind foot should face outwards with a tilt of around 30 degrees", "timestamp": 444}
      ]
    },
    {
      "key": "front-stance",
      "name": {"en": "Front Stance", "ko": "앞굽이", "romanized": "Ap Gubi"},
      "category": "stance",
      "video_timestamp": 449,
      "video_timestamp_end": 487,
      "tips": [
        {"text": "The knee on the front leg is bent and the two legs are spread apart", "timestamp": 456},
        {"text": "The distance between front and hind foot should be about one and a half steps", "timestamp": 461},
        {"text": "The space between the two feet should be about the length of a fist", "timestamp": 467},
        {"text": "The sole of the hind foot should face outwards with a tilt of around 30 degrees", "timestamp": 474},
        {"text": "The knee of your front leg should not bend excessively nor stick out in front of the tip of the foot", "timestamp": 480},
        {"text": "Your hind leg should straighten in a straight line", "timestamp": 484}
      ]
    }
