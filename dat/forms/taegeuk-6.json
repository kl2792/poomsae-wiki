  "techniques": [
    {
      "key": "ready",
      "name": {
        "en": "Ready",
        "ko": "준비",
        "romanized": "Junbi"
      },
      "category": "stance",
      "video_timestamp": 136.0,
      "tips": [
        {
          "text": "These are the key moves of Taegeuk Yukjang.",
          "timestamp": 136.0,
          "source": "caption"
        },
        {
          "text": "We will now take a closer look at each of the key moves of Taegeuk Yukjang.",
          "timestamp": 140.0,
          "source": "caption"
        },
        {
          "text": "Sonnal Olgul Bituromaki is a technique used to perform Olgul Bakanmaki",
          "timestamp": 145.0,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 147.0
    },
    {
      "key": "knifehand-high-twisting-block",
      "name": {
        "en": "Knifehand High Twisting Block",
        "ko": "손날얼굴비틀어막기",
        "romanized": "Sonal Ulgul Biteureomakgi"
      },
      "category": "block",
      "video_timestamp": 147.0,
      "tips": [
        {
          "text": "Twist your torso about 45 degrees from the Apgubi posture",
          "timestamp": 157
        },
        {
          "text": "Your arms should cross and pass in front of your face",
          "timestamp": 164
        },
        {
          "text": "Bakkanmakgi performed with the tip of your hands facing upward",
          "timestamp": 167
        },
        {
          "text": "Your blocking arm should cross outside your assisting arm",
          "timestamp": 172
        },
        {
          "text": "Be careful not to let your hand blade move outside the end of the line from your shoulder",
          "timestamp": 177
        },
        {
          "text": "The knee of your hind leg should not bend, and your sole must not leave the ground",
          "timestamp": 183
        },
        {
          "text": "using the performance thrusting foot and the opposite hand blade.",
          "timestamp": 153.7,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 191.0
    },
    {
      "key": "roundhouse-kick",
      "name": {
        "en": "Roundhouse Kick",
        "ko": "돌려차기",
        "romanized": "Dollyeochagi"
      },
      "category": "kick",
      "video_timestamp": 191.0,
      "tips": [
        {
          "text": "Use the top of your foot and ball to strike the target",
          "timestamp": 199
        },
        {
          "text": "After kicking a target, perform a spinning kick by twisting your torso as if you are spinning your shoulder on the same side backwards",
          "timestamp": 204
        },
        {
          "text": "Your kicking foot draws an arc outside in.",
          "timestamp": 194.9,
          "source": "caption"
        },
        {
          "text": "as if you're spinning your shoulder on the same side backwards.",
          "timestamp": 209.9,
          "source": "caption"
        },
        {
          "text": "Bakanmaki is a technique used to block, defend your face inside out using your wrist.",
          "timestamp": 213.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 219.0
    },
    {
      "key": "high-outward-block",
      "name": {
        "en": "High Outward Block",
        "ko": "얼굴바깥막기",
        "romanized": "Ulgul Bakkat Makki"
      },
      "category": "block",
      "video_timestamp": 219.0,
      "tips": [
        {
          "text": "Your blocking arm should cross past your face from outside your assisting arm",
          "timestamp": 225.3,
          "source": "caption"
        },
        {
          "text": "to perform the Bakanmaki.",
          "timestamp": 230.3,
          "source": "caption"
        },
        {
          "text": "Your elbow should point downward, your fist upward, and at a philtrum elevation.",
          "timestamp": 232.3,
          "source": "caption"
        },
        {
          "text": "Be careful not to let your blocking wrist move outside the end of the line from your shoulder",
          "timestamp": 243.5,
          "source": "caption"
        },
        {
          "text": "when performing the move.",
          "timestamp": 250.3,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 253.0
    },
    {
      "key": "low-spreading-block",
      "name": {
        "en": "Low Spreading Block",
        "ko": "아래헤쳐막기",
        "romanized": "Arae Hecheomakgi"
      },
      "category": "block",
      "video_timestamp": 253.0,
      "tips": [
        {
          "text": "It begins with your arms crossed in an X formation in front of your chest.",
          "timestamp": 260.3,
          "source": "caption"
        },
        {
          "text": "Lower your arms to your lower abdomen, then block the lower part of your body from both sides.",
          "timestamp": 265.3,
          "source": "caption"
        },
        {
          "text": "When blocking your lower body, your arms should straighten naturally,",
          "timestamp": 272.3,
          "source": "caption"
        },
        {
          "text": "and the space between your fist and legs should be about two raised fists length.",
          "timestamp": 276.3,
          "source": "caption"
        },
        {
          "text": "Also, the back of your hammer fist and your front thigh should be aligned when seen from the front.",
          "timestamp": 281.3,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 289.0
    },
    {
      "key": "palm-middle-inward-block",
      "name": {
        "en": "Palm Middle Inward Block",
        "ko": "바탕손몸통안막기",
        "romanized": "Batangson Momtong An Makki"
      },
      "category": "block",
      "video_timestamp": 289.0,
      "tips": [
        {
          "text": "Raise the fist of your assisting arm slightly to your solar plexus level.",
          "timestamp": 296.3,
          "source": "caption"
        },
        {
          "text": "Your blocking hand should start about one hand length above your shoulder to block inward.",
          "timestamp": 301.3,
          "source": "caption"
        },
        {
          "text": "When blocking, the palm of your hand should be placed in front of your solar plexus,",
          "timestamp": 307.3,
          "source": "caption"
        },
        {
          "text": "and your armpit should be touching your body.",
          "timestamp": 311.3,
          "source": "caption"
        },
        {
          "text": "Your elbow should point downward.",
          "timestamp": 314.3,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 349.0
    },
