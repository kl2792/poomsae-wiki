  "techniques": [
    {
      "key": "ready",
      "name": {
        "en": "Ready",
        "ko": "준비",
        "romanized": "Junbi"
      },
      "category": "stance",
      "video_timestamp": 130.0,
      "tips": [],
      "video_timestamp_end": 147.0
    },
    {
      "key": "knifehand-augmented-block",
      "name": {
        "en": "Knifehand Augmented Block",
        "ko": "기본 준비자세",
        "romanized": "Sonal Geodeureo Makki"
      },
      "category": "block",
      "video_timestamp": 147.0,
      "tips": [
        {
          "text": "Sonal Geodeureomakgi is a technique of defending using two hands where the supporting hand assists when performing Sonal Bakkanmakgi",
          "timestamp": 178
        },
        {
          "text": "The hand defending the torso should be placed at the solar plexus level",
          "timestamp": 187
        },
        {
          "text": "While the supporting hand should be placed at the elbow level of the defending arm",
          "timestamp": 191
        },
        {
          "text": "The elbow of the supporting arm should be placed where it crosses the center line",
          "timestamp": 196
        },
        {
          "text": "The space between the outer wrist of the supporting arm and the torso should be about one hand blade",
          "timestamp": 204
        },
        {
          "text": "Be careful not to let the elbow rise due to the opening of the armpit of the supporting arm",
          "timestamp": 216
        }
      ],
      "video_timestamp_end": 157.0
    },
    {
      "key": "vertical-fingertip-thrust",
      "name": {
        "en": "Vertical Fingertip Thrust",
        "ko": "손날몸통바깥막기",
        "romanized": "Pyeonsonkeut Sewo Jireugi"
      },
      "category": "strike",
      "video_timestamp": 223.0,
      "tips": [
        {
          "text": "This has the effect of concentrating force in one place with high pressure",
          "timestamp": 231
        },
        {
          "text": "As the area of contact with an opponent is small",
          "timestamp": 238
        },
        {
          "text": "You can prevent injuries and concentrate your force by placing the index, middle and the ring finger together in a straight line",
          "timestamp": 244
        },
        {
          "text": "Be careful not to let your wrist bend",
          "timestamp": 253
        },
        {
          "text": "Be careful not to let your wrist bend when performing Jireugi.",
          "timestamp": 253.0,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 258.0
    },
    {
      "key": "swallow-form-inward-strike",
      "name": {
        "en": "Swallow Form Inward Strike",
        "ko": "제비품안치기",
        "romanized": "Jebipum Anchigi"
      },
      "category": "strike",
      "video_timestamp": 258.0,
      "tips": [
        {
          "text": "Perform the preparatory move by placing the left hand in front of the torso, and the wrist of the right hand above the shoulder",
          "timestamp": 268
        },
        {
          "text": "Tilt the body about 45 degrees",
          "timestamp": 281
        },
        {
          "text": "And then simultaneously perform Oen Sonal Ulgulmakgi and Oreun Sonal Anchigi",
          "timestamp": 285
        },
        {
          "text": "The right hand should be placed at the neck level with the elbows slightly bent",
          "timestamp": 293
        },
        {
          "text": "The hand that performed Anchigi should be placed at the crossing with the center line in front",
          "timestamp": 301
        },
        {
          "text": "And your torso should stand straight",
          "timestamp": 307
        },
        {
          "text": "Be careful not to lose balance or let your torso swerve to the right due to excessive twisting",
          "timestamp": 313
        },
        {
          "text": "Remove unnecessary force.",
          "timestamp": 280.1,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 375.0
    },
    {
      "key": "side-kick",
      "name": {
        "en": "Side Kick",
        "ko": "(몸통)안막기",
        "romanized": "Yeopchagi"
      },
      "category": "kick",
      "video_timestamp": 157.0,
      "tips": [
        {
          "text": "The kicking leg should be raised higher than the supporting knee, above the waist",
          "timestamp": 329
        },
        {
          "text": "Bend your knee, twist your pelvis, and straighten your leg to kick",
          "timestamp": 335
        },
        {
          "text": "Your shoulder, hips and heel should form a straight line",
          "timestamp": 348
        },
        {
          "text": "Be careful not to let the heel of your supporting leg twist too early in the direction of the kick",
          "timestamp": 353
        },
        {
          "text": "These are the five key moves of Taeguk Sajang.",
          "timestamp": 163.4,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 223.0
    },
    {
      "key": "backfist-front-strike",
      "name": {
        "en": "Back Fist Front Strike",
        "ko": "올려(얼굴)막기",
        "romanized": "Deungjumok Apchigi"
      },
      "category": "strike",
      "video_timestamp": 375.0,
      "tips": [
        {
          "text": "Your arms should cross at the solar plexus level, and the striking fist should pass under the supporting arm, making an arc",
          "timestamp": 386
        },
        {
          "text": "The back of the fist should be at the philtrum level along the center line when seen from the front",
          "timestamp": 394
        },
        {
          "text": "Be careful not to let the elbow of the striking arm point outward",
          "timestamp": 403
        },
        {
          "text": "These are the five key moves of Taeguk Sajang.",
          "timestamp": 407.0,
          "source": "caption"
        },
        {
          "text": "We will now look at the moves in succession, connecting each move.",
          "timestamp": 412.2,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 435.0
    },
