      "tips": [
        {
          "text": "The wrist of the right hand should be above the shoulder",
          "timestamp": 275
        },
        {
          "text": "Simultaneously perform Oen Sonal Ulgulmakgi and Oreun Sonal Anchigi",
          "timestamp": 284
        },
        {
          "text": "The right hand should be placed at the neck level with the elbows slightly bent",
          "timestamp": 293
        },
        {
          "text": "The hand that performed Anchigi should be placed at the crossing with the center line in front",
          "timestamp": 301
        },
        {
          "text": "Be careful not to lose balance or let your torso swerve to the right due to excessive twisting",
          "timestamp": 313
        }
