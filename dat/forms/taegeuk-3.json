      "category": "strike",
      "video_timestamp": 127.0,
      "tips": [
        { "text": "The hand blade, used in the move, extends from the wrist to the first joint of the little finger", "timestamp": 156 },
        { "text": "First open your hand, place the four fingers from the index to the little finger together", "timestamp": 163 },
        { "text": "Then bend the tip of the thumb and place it on top of the first joint of the index finger", "timestamp": 170 },
        { "text": "And bend the tips a little inward", "timestamp": 180 },
        { "text": "Place the wrist of the thrusting arm at shoulder level, and the supporting arm at the solar plexus level", "timestamp": 189 },
        { "text": "Perform the Sonal Anchigi move by pulling both elbows towards your body", "timestamp": 203 },
        { "text": "Place your supporting hand back at the wrist", "timestamp": 213 },
        { "text": "The wrist of the striking hand should be straight", "timestamp": 219 },
        { "text": "And your hand blade should be raised near your neck level", "timestamp": 224 }
      ]
    },
    {
      "key": "02",
      "id": "sonal-momtong-bakkan-makki",
      "name": { "en": "Knifehand Outward Middle Block", "ko": "손날몸통바깥막기" },
      "category": "block",
      "video_timestamp": 227.0,
      "tips": [
        { "text": "Begin with two arms crossed in front of the chest", "timestamp": 242 },
        { "text": "The defending arm and supporting arm should be placed on the outside and inside respectively when the arms are crossed", "timestamp": 246 },
        { "text": "The tip of the hand of the defending arm should not be above the shoulder when defending", "timestamp": 258 },
        { "text": "And the elbow should face downward", "timestamp": 262 },
        { "text": "Be careful not to let the wrist bend", "timestamp": 268 },
        { "text": "And the hand blade should not be outside the end of the line extending from the torso", "timestamp": 272 }
      ]
    },
