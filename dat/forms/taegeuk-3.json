    },
    {
      "key": "knifehand-strike",
      "name": {
        "en": "Knifehand Strike",
        "ko": "손날안치기",
        "romanized": "Sonnal Anchigi"
      },
      "category": "strike",
      "video_timestamp": 127.0,
      "tips": [
        {
          "text": "The hand blade, used in the move, extends from the wrist to the first joint of the little finger",
          "timestamp": 156
        },
        {
          "text": "First open your hand, place the four fingers from the index to the little finger together",
          "timestamp": 163
        },
        {
          "text": "Then bend the tip of the thumb and place it on top of the first joint of the index finger",
          "timestamp": 170
        },
        {
          "text": "And bend the tips a little inward",
          "timestamp": 180
        },
        {
          "text": "Place the wrist of the thrusting arm at shoulder level, and the supporting arm at the solar plexus level",
          "timestamp": 189
        },
        {
          "text": "Perform the Sonal Anchigi move by pulling both elbows towards your body",
          "timestamp": 203
        },
        {
          "text": "Place your supporting hand back at the wrist",
          "timestamp": 213
        },
        {
          "text": "The wrist of the striking hand should be straight",
          "timestamp": 219
        },
        {
          "text": "And your hand blade should be raised near your neck level",
          "timestamp": 224
        }
      ]
    },
    {
      "key": "knifehand-outward-middle-block",
      "name": {
        "en": "Knifehand Outward Middle Block",
        "ko": "손날몸통바깥막기",
        "romanized": "Sonnal Momtong Bakkat Makgi"
      },
      "category": "block",
      "video_timestamp": 227.0,
      "tips": [
        {
          "text": "Begin with two arms crossed in front of the chest",
          "timestamp": 242
        },
        {
          "text": "The defending arm and supporting arm should be placed on the outside and inside respectively when the arms are crossed",
          "timestamp": 246
        },
        {
          "text": "The tip of the hand of the defending arm should not be above the shoulder when defending",
          "timestamp": 258
        },
        {
          "text": "And the elbow should face downward",
          "timestamp": 262
        },
        {
          "text": "Be careful not to let the wrist bend",
          "timestamp": 268
        },
        {
          "text": "And the hand blade should not be outside the end of the line extending from the torso",
          "timestamp": 272
        }
      ]
    },
    {
      "key": "back-stance",
      "name": {
        "en": "Back Stance",
        "ko": "뒷굽이",
        "romanized": "Dwit Gubi"
      },
      "category": "stance",
      "video_timestamp": 276.0,
      "tips": [
        {
          "text": "Your feet should form a 90 degree angle",
          "timestamp": 281
        },
        {
          "text": "The direction of your knees and feet should be identical",
          "timestamp": 288
        },
        {
          "text": "The center of your body should be 2/3 towards the back",
          "timestamp": 292
        },
        {
          "text": "Move your left foot one step forward",
          "timestamp": 298
        },
        {
          "text": "Stand low like you would for Juchumseogi",
          "timestamp": 303
        }
      ]
    },
