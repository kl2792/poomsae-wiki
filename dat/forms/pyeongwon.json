  "techniques": [
    {
      "key": "01",
      "name": {
        "en": "Overlapping Hands Ready Stance",
        "ko": "겹손 준비자세",
        "romanized": "Gyeopson Junbi Jase"
      },
      "category": "stance",
      "video_timestamp": 164,
      "tips": [
        {
          "text": "A preparation posture in which both arms straighten from Moaseogi",
          "timestamp": 169
        },
        {
          "text": "The left hand is placed over the back of the right hand in the shape of a cross",
          "timestamp": 173
        },
        {
          "text": "The hands should be slightly apart from the body in front of the lower abdomen",
          "timestamp": 179
        },
        {
          "text": "Prepare the fingertips of both hands together and your fingers should not be spread apart",
          "timestamp": 190
        }
      ]
    },
    {
      "key": "02",
      "name": {
        "en": "Elbow Upper Strike",
        "ko": "팔꿈치 올려치기",
        "romanized": "Palkkumchi Ollyeo Chigi"
      },
      "category": "strike",
      "video_timestamp": 197,
      "tips": [
        {
          "text": "Make sufficient use of the twisting of your torso with your elbow close to your body",
          "timestamp": 220
        },
        {
          "text": "Raise your fist to reduce resistance from your muscles and maintain a sufficient range of movement",
          "timestamp": 225
        },
        {
          "text": "Be careful not to straighten the arm to strike upward",
          "timestamp": 232
        }
      ]
    },
    {
      "key": "03",
      "name": {
        "en": "Assisted High Side Block",
        "ko": "거들어 얼굴엎막기",
        "romanized": "Geodeureo Ulgul Yeop Makgi"
      },
      "category": "block",
      "video_timestamp": 238,
      "tips": [
        {
          "text": "The blocking arm should pass the face and the elbow placed to your side level with your philtrum",
          "timestamp": 247
        },
        {
          "text": "Your elbow should straighten and be perpendicular to the ground",
          "timestamp": 253
        },
        {
          "text": "The assisting arm should be parallel to the ground at chest height",
          "timestamp": 257
        },
        {
          "text": "The space between your body and arm should be about one raised fist's length",
          "timestamp": 262
        },
        {
          "text": "The fist on the assisting arm should not move outside the body",
          "timestamp": 268
        },
        {
          "text": "The blocking arm should not tilt front/back, left/right",
          "timestamp": 272
        }
      ]
    },
    {
      "key": "04",
      "name": {
        "en": "Pulling Back-fist Front Strike",
        "ko": "당겨 등주먹 앞치기",
        "romanized": "Danggyeo Deungjumeok Apchigi"
      },
      "category": "strike",
      "video_timestamp": 276,
      "tips": [
        {
          "text": "The back fist is placed in front of the philtrum",
          "timestamp": 297
        },
        {
          "text": "It should not be a strike from the outside in, like Mejumeok Anchigi",
          "timestamp": 300
        }
      ]
    },
    {
      "key": "05",
      "name": {
        "en": "Collar Strike",
        "ko": "명에치기",
        "romanized": "Meongyechigi"
      },
      "category": "strike",
      "video_timestamp": 306,
      "tips": [
        {
          "text": "Your back fist must face upward",
          "timestamp": 320
        },
        {
          "text": "The back of your two hammer fists should lightly touch your chest",
          "timestamp": 323
        },
        {
          "text": "Your arms must be parallel",
          "timestamp": 327
        },
        {
          "text": "Be careful not to let your elbows move back and make sure your chest does not open",
          "timestamp": 332
        }
      ]
    },
    {
      "key": "06",
      "name": {
        "en": "Spreading Mountain Block",
        "ko": "헤쳐 산틀막기",
        "romanized": "Hecheo Santeul Makgi"
      },
      "category": "block",
      "video_timestamp": 343,
      "tips": [
        {
          "text": "Arms cross at the lower abdomen, move to your sides horizontally",
          "timestamp": 347
        },
        {
          "text": "In front of your face to perform Ulgul Hecheomakgi with your inner wrist",
          "timestamp": 353
        },
        {
          "text": "Your arms should be at the philtrum level and perpendicular to the ground",
          "timestamp": 359
        },
        {
          "text": "Be careful not to let the wrist bend",
          "timestamp": 365
        },
        {
          "text": "The blocking arm must not tilt front/back, left/right",
          "timestamp": 369
        }
      ]
    },
    {
      "key": "07",
      "name": {
        "en": "Close Stance",
        "ko": "모아서기",
        "romanized": "Moa Seogi"
      },
      "category": "stance",
      "video_timestamp": 375,
      "tips": [
        {
          "text": "Your eyes should be directed forward and be careful not to let space exist between your feet",
          "timestamp": 386
        }
