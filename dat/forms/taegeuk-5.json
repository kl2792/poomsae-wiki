      "video_timestamp_end": 155.0
    },
    {
      "key": "hammer-fist-downward-strike",
      "name": {
        "en": "Hammer Fist Downward Strike",
        "ko": "메주먹내려치기",
        "romanized": "Mejumeok Naeryeochigi"
      },
      "category": "strike",
      "video_timestamp": 155.0,
      "tips": [
        {
          "text": "While your arms cross at the solar plexus, your assisting arm should face outward",
          "timestamp": 165
        },
        {
          "text": "The striking hand should pass under the assisting arm",
          "timestamp": 173
        },
        {
          "text": "Draw an arc above your head, and stop at the shoulder line with your arm naturally straightened",
          "timestamp": 179
        },
        {
          "text": "Your fist should not stop at the head",
          "timestamp": 187
        },
        {
          "text": "Be careful not to let your arm bend",
          "timestamp": 192
        },
        {
          "text": "Mejumok Neryochigi is a technique used to strike an opponent by drawing a big descending circle with your hammer fist.",
          "timestamp": 155.3,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 197.0
    },
    {
      "key": "elbow-turning-strike",
      "name": {
        "en": "Elbow Turning Strike",
        "ko": "팔꿈치돌려치기",
        "romanized": "Palggumchi Dollyeochigi"
      },
      "category": "strike",
      "video_timestamp": 197.0,
      "tips": [
        {
          "text": "Bend your elbow so the back of your hand faces upward",
          "timestamp": 204
        },
        {
          "text": "Place the fist in front of the shoulder of your striking arm, spin your torso and strike",
          "timestamp": 207
        },
        {
          "text": "Your elbow should be slightly above your shoulder",
          "timestamp": 215
        },
        {
          "text": "The elbow and fist should be placed along the same line",
          "timestamp": 220
        },
        {
          "text": "Be careful not to let your fist fall below your shoulder",
          "timestamp": 225
        },
        {
          "text": "Assist the Palggumchi Dollyeochigi by letting it touch the palm of the hand assisting",
          "timestamp": 229
        },
        {
          "text": "Do not hold your fist with the open hand of the assisting arm",
          "timestamp": 241
        },
        {
          "text": "Palgunji Neryochigi is a technique used to strike with the elbow in a swinging motion.",
          "timestamp": 197.3,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 246.0
    },
    {
      "key": "elbow-target-strike",
      "name": {
        "en": "Elbow Target Strike",
        "ko": "팔꿈치표적치기",
        "romanized": "Palggumchi Pyojeokchigi"
      },
      "category": "strike",
      "video_timestamp": 246.0,
      "tips": [
        {
          "text": "The elbow of the arm creating a target should be slightly bent and at solar plexus elevation",
          "timestamp": 259
        },
        {
          "text": "Be careful not to let the palm of the assisting hand hit your elbow or hold your elbow with your hand",
          "timestamp": 267
        },
        {
          "text": "Palgunji Pyojokchigi is a technique used to create a target by opening your assisting hand,",
          "timestamp": 246.0,
          "source": "caption"
        },
        {
          "text": "twisting your torso about 45 degrees, and striking a target with the elbow.",
          "timestamp": 253.0,
          "source": "caption"
        },
        {
          "text": "Goasogi is a posture where you bend your knees by twisting your feet using a low stance one fist's width between your feet.",
          "timestamp": 277.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 280.0
    },
    {
      "key": "twisted-stance",
      "name": {
        "en": "Twisted Stance",
        "ko": "꼬아서기",
        "romanized": "Kkoaseogi"
      },
      "category": "stance",
      "video_timestamp": 280.0,
      "tips": [
        {
          "text": "Kkoaseogi is a posture where you bend your knees by twisting your feet",
          "timestamp": 280
        },
        {
          "text": "Using a low stance, one fist's width between your feet",
          "timestamp": 284
        },
        {
          "text": "With the shin of one leg touching the calf of the other",
          "timestamp": 292
        },
        {
          "text": "Be careful not to let your shin and calf part",
          "timestamp": 311
        },
        {
          "text": "Stand low like Juchumsogi with the shin of one leg touching the calf of the other.",
          "timestamp": 286.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 315.0
    },
    {
      "key": "side-stance",
      "name": {
        "en": "Side Stance",
        "ko": "옆서기",
        "romanized": "Yeopseogi"
      },
      "category": "stance",
      "video_timestamp": 315.0,
      "tips": [
        {
