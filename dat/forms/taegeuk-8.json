    },
    {
      "key": "augmented-outward-block",
      "name": {
        "en": "Augmented Outward Block",
        "ko": "거들어바깥막기",
        "romanized": "Geodeureo Bakkat Makki"
      },
      "category": "block",
      "video_timestamp": 199.0,
      "tips": [
        {
          "text": "The fist blocking the torso should be placed correctly",
          "timestamp": 213
        },
        {
          "text": "Be careful not to let the blocking hand move outside the outer line of the body",
          "timestamp": 223
        },
        {
          "text": "Koduro bakkadmakgi is a technique to block with your hands with help from the assisting hand.",
          "timestamp": 200.9,
          "source": "caption"
        },
        {
          "text": "The fist blocking the torso should be placed at the solar plexus level,",
          "timestamp": 210.5,
          "source": "caption"
        },
        {
          "text": "while assisting hand is placed level with the blocking elbow.",
          "timestamp": 217.2,
          "source": "caption"
        }
