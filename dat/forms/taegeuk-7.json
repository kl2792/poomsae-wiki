  "techniques": [
    {
      "key": "knifehand-assisted-low-block",
      "name": {
        "en": "Knifehand Assisted Low Block",
        "ko": "손날거들어아래막기",
        "romanized": "Sonal Geodeureo Arae Makgi"
      },
      "category": "block",
      "video_timestamp": 177,
      "video_timestamp_end": 233,
      "tips": [
        {
          "text": "The blocking hand is placed over the knee forward about two fists length apart",
          "timestamp": 188
        },
        {
          "text": "The assisting hand is raised to the same level as the elbow of the arm blocking the lower body",
          "timestamp": 195
        },
        {
          "text": "The wrist of the assisting arm is placed where it crosses the center line",
          "timestamp": 201
        },
        {
          "text": "The space between the outer wrist and torso should be about one hand blade apart",
          "timestamp": 211
        },
        {
          "text": "Be careful not to let your blocking hand move outside the line connecting your leg and body",
          "timestamp": 223
        },
        {
          "text": "The assisting armpit should not detach from your body, making the elbow rise up",
          "timestamp": 227
        }
      ]
    },
    {
      "key": "assisted-palmheel-middle-inside-block",
      "name": {
        "en": "Assisted Palmheel Middle Inside Block",
        "ko": "거들어바탕손몸통안막기",
        "romanized": "Geodeureo Batangson Momtong An Makgi"
      },
      "category": "block",
      "video_timestamp": 234,
      "video_timestamp_end": 287,
      "tips": [
        {
          "text": "When initiating this move, straighten the assisting arm slightly at the solar plexus level",
          "timestamp": 246
        },
        {
          "text": "Start your blocking hand one hand's length above your shoulder, and block inwards",
          "timestamp": 251
        },
        {
          "text": "Place the palm of your hand of the blocking arm in front of the solar plexus",
          "timestamp": 258
        },
        {
          "text": "The back of the assisting hand should point upward",
          "timestamp": 265
        },
        {
          "text": "Assist by letting the elbow of the blocking arm lightly rest on it",
          "timestamp": 268
        },
        {
          "text": "Block by pulling the elbow of the blocking arm towards the body",
          "timestamp": 274
        },
        {
          "text": "Pull your assisting arm",
          "timestamp": 281
        }
      ]
    },
    {
      "key": "covered-fist",
      "name": {
        "en": "Covered Fist",
        "ko": "보주먹",
        "romanized": "Bojumeok"
      },
      "category": "strike",
      "video_timestamp": 288,
      "video_timestamp_end": 327,
      "tips": [
        {
          "text": "The four fingers of your left hand wrap around the four fingers of your right fist",
          "timestamp": 298
        },
        {
          "text": "The space between your fists should be a sheet of paper's width",
          "timestamp": 308
        },
        {
          "text": "The assisting fist starts in front of the lower abdomen",
          "timestamp": 315
        },
        {
          "text": "The internal angle of your arm should be between 90° and 120°",
          "timestamp": 322
        }
      ]
    },
    {
      "key": "scissors-block",
      "name": {
        "en": "Scissors Block",
        "ko": "가위막기",
        "romanized": "Gawi Makgi"
      },
      "category": "block",
      "video_timestamp": 328,
      "video_timestamp_end": 359,
      "tips": [
        {
          "text": "It starts with both arms crossed in front of the chest",
          "timestamp": 338
        },
        {
          "text": "The wrist of the arm performing Anpalmok Bakkanmakgi should be placed at the solar plexus level",
          "timestamp": 345
        },
        {
          "text": "Your fist must not rise above your shoulder",
          "timestamp": 349
        },
        {
          "text": "The fist that performed Araemakgi should maintain its position two raised fists above the knee",
          "timestamp": 352
        }
      ]
    },
    {
      "key": "knee-strike",
      "name": {
        "en": "Knee Strike",
        "ko": "무릎치기",
        "romanized": "Mureup Chigi"
      },
      "category": "strike",
      "video_timestamp": 360,
      "video_timestamp_end": 374,
      "tips": [
        {
          "text": "Kick upward with your knee folded as much as possible",
          "timestamp": 368
        }
      ]
    },
    {
      "key": "middle-spreading-block",
      "name": {
        "en": "Middle Spreading Block",
        "ko": "몸통헤쳐막기",
        "romanized": "Momtong Hecheo Makgi"
      },
      "category": "block",
      "video_timestamp": 375,
      "video_timestamp_end": 396,
      "tips": [
        {
          "text": "Hecheomakgi is a technique used to block inside out simultaneously by crossing your wrists in front of your chest",
          "timestamp": 380
        },
        {
          "text": "Your fists must be in front of your shoulders when blocking",
          "timestamp": 387
        },
        {
          "text": "Your elbows should point downward",
          "timestamp": 391
        },
        {
          "text": "Your two armpits should softly touch your torso",
          "timestamp": 393
        }
      ]
    },
    {
      "key": "double-fist-upset-punch",
      "name": {
        "en": "Double Fist Upset Punch",
        "ko": "두주먹제쳐지르기",
        "romanized": "Dujumeok Jeocheo Jireugi"
      },
      "category": "strike",
      "video_timestamp": 398,
      "video_timestamp_end": 451,
      "tips": [
        {
          "text": "Your two fists start at the back",
          "timestamp": 405
        },
        {
          "text": "When thrusting, keep your arms in, touching the torso",
          "timestamp": 422
        },
        {
          "text": "Place your elbows close to your torso",
          "timestamp": 426
        },
        {
          "text": "Jeocheojireugi should be performed by thrusting upward (about one fist length above the elbow) slightly from below",
          "timestamp": 430
        },
        {
          "text": "The elbow should not move away from the body too much",
          "timestamp": 439
        },
        {
          "text": "Your fists must not open outward",
          "timestamp": 442
        },
        {
          "text": "Be careful not to let your fists rise above the elbow level or thrust downward",
          "timestamp": 447
        }
      ]
    },
    {
      "key": "crossed-low-block",
      "name": {
        "en": "Crossed Low Block",
        "ko": "엇걸어아래막기",
        "romanized": "Utgeoreo Arae Makgi"
      },
      "category": "block",
      "video_timestamp": 453,
      "video_timestamp_end": 486,
      "tips": [
        {
          "text": "For Oen Apgubi, start with your right arm back and cross your right arm upwards",
