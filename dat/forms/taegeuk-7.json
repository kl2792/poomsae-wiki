      "category": "stance",
      "video_timestamp": 563,
      "video_timestamp_end": 609,
      "tips": [
        {
          "text": "Beomseogi posture is achieved by shifting your weight on your hind leg",
          "timestamp": 567
        },
        {
          "text": "Standing low after setting your front foot forward",
          "timestamp": 571
        },
        {
          "text": "About a foot length from the tip of the big toe to your hind foot",
          "timestamp": 575
        },
        {
          "text": "Raise your heel so only the ball of the front foot touches the ground",
          "timestamp": 581
        },
        {
          "text": "Support your weight with your hind leg so that your weight is distributed equally on both your hind and front leg 9:1",
          "timestamp": 588
        },
        {
          "text": "Slowly tighten legs inward and stand with your knees tilted forward",
          "timestamp": 598
        }
