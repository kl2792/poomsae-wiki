  "techniques": [
    {
      "key": "tiger-stance-knifehand-low-downward-spreading-block",
      "name": {
        "en": "Tiger Stance Knifehand Low Downward Spreading Block",
        "ko": "기본 준비자세",
        "romanized": "Beomseogi Sonal Arae Naeryeo Hecheomakgi"
      },
      "category": "block",
      "video_timestamp": 145,
      "tips": [
        {
          "text": "When performing Bomseogi Sonnal Arae Haecheomagi, both hands should be placed in the center line of the thigh of the front leg.",
          "timestamp": 146.6,
          "source": "caption"
        },
        {
          "text": "The back of your hands should each face outward and the space between your hand and body should be about one hand's length sideways.",
          "timestamp": 154.6,
          "source": "caption"
        },
        {
          "text": "Start in front of your chest and perform Haecheomagi downward.",
          "timestamp": 162.6,
          "source": "caption"
        },
        {
          "text": "When assuming postures where the legs are spread forwards and backwards like Bomseogi and Apgubi,",
          "timestamp": 166.6,
          "source": "caption"
        },
        {
          "text": "the arm on the same side as the front foot should cross from the outside.",
          "timestamp": 173.6,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 178
    },
    {
      "key": "knifehand-overturning-grab",
      "name": {
        "en": "Knifehand Overturning Grab",
        "ko": "손날몸통바깥막기",
        "romanized": "Sonal Eopeojapgi"
      },
      "category": "strike",
      "video_timestamp": 178,
      "tips": [
        {
          "text": "For Sonnal Oppo Japgi, assume an opponent has hold of you.",
          "timestamp": 178.6,
          "source": "caption"
        },
        {
          "text": "Twist the thumb of the hand being held outside.",
          "timestamp": 182.6,
          "source": "caption"
        },
        {
          "text": "Then open your hand so the palm is seen from above.",
          "timestamp": 185.6,
          "source": "caption"
        },
        {
          "text": "Raise your hand and pull it close to your body to release your wrist.",
          "timestamp": 189.6,
          "source": "caption"
        },
        {
          "text": "Open your arm inside out and cover the back of the hand of your opponent.",
          "timestamp": 193.6,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 213
    },
    {
      "key": "diamond-inner-forearm-outward-block",
      "name": {
        "en": "Diamond Inner Forearm Outward Block",
        "ko": "제비품안치기",
        "romanized": "Geumgang Anpalmok Bakkanmakgi"
      },
      "category": "block",
      "video_timestamp": 213,
      "tips": [
        {
          "text": "For Geumgang Bakalmaki, start with Jangun Doljakui and move together to the center line.",
          "timestamp": 213.6,
          "source": "caption"
        },
        {
          "text": "This is a technique where the outer arm performs Olgulmaki",
          "timestamp": 221.6,
          "source": "caption"
        },
        {
          "text": "and the inner arm performs Anpalmok Bakalmaki at the same time.",
          "timestamp": 225.6,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 230
    },
    {
      "key": "throwing-twist-escape",
      "name": {
        "en": "Throwing Twist Escape",
        "ko": "(몸통)안막기",
        "romanized": "Meteuro Teureoppaegi"
      },
      "category": "block",
      "video_timestamp": 230,
      "tips": [
        {
          "text": "Turoppegi is a technique where you spin the thumb toward the inner wrist",
          "timestamp": 230.6,
          "source": "caption"
        },
        {
          "text": "and release between an opponent's thumb and index finger.",
          "timestamp": 235.6,
          "source": "caption"
        },
        {
          "text": "When performing Olgulpakachigi, strengthen the shoulder and shoulder blade",
          "timestamp": 240.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 241
    },
    {
      "key": "backfist-high-outward-strike",
      "name": {
        "en": "Back Fist High Outward Strike",
        "ko": "올려(얼굴)막기",
        "romanized": "Deungjumeok Ulgul Bakkanchigi"
      },
      "category": "strike",
      "video_timestamp": 241,
      "tips": [
        {
          "text": "by bending the elbow and utilize the torque of the torso.",
          "timestamp": 245.9,
          "source": "caption"
        },
        {
          "text": "The elbow should face downward and the fist raised level with the temple.",
          "timestamp": 249.9,
          "source": "caption"
        },
        {
          "text": "Be careful not to bend the elbow.",
          "timestamp": 255.9,
          "source": "caption"
        },
        {
          "text": "These are the five key moves of Taebaek Pumsae.",
          "timestamp": 258.9,
          "source": "caption"
        },
        {
          "text": "We will now look at the moves in succession connecting each move.",
          "timestamp": 262.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 301
    },
