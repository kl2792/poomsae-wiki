  "techniques": [
    {
      "key": "01",
      "name": {
        "en": "Tiger Stance Knife-hand Low Spreading Block",
        "ko": "범서기 손날 아래(내려)헤쳐막기",
        "romanized": "Beomseogi Sonnal Arae Naeryeo Hecheo Makgi"
      },
      "category": "block",
      "video_timestamp": 145,
      "tips": [
        {
          "text": "The back of your hands should each face outward",
          "timestamp": 155
        },
        {
          "text": "The space between your hand and body should be about one hand's length sideways",
          "timestamp": 158
        },
        {
          "text": "Start in front of your chest and perform Hecheomakgi downward",
          "timestamp": 163
        },
        {
          "text": "The arm on the same side as the front foot should cross from the outside",
          "timestamp": 174
        },
        {
          "text": "When blocking from the Oen Beomseogi posture, the left arm should cross on the outside",
          "timestamp": 312
        },
        {
          "text": "The Apchagi should be performed forward in a straight line",
          "timestamp": 318
        },
        {
          "text": "The kicking foot is folded after the kick",
          "timestamp": 322
        },
        {
          "text": "The ball should touch the ground first",
          "timestamp": 325
        },
        {
          "text": "Then complete your breath and move the moment your heel touches the ground",
          "timestamp": 328
        },
        {
          "text": "The lower body should be planted firm to maintain balance",
          "timestamp": 336
        }
      ]
    },
    {
      "key": "02",
      "name": {
        "en": "Knife-hand Neck Grasp",
        "ko": "손날 엎어잡기",
        "romanized": "Sonnal Eopeojapgi"
      },
      "category": "strike",
      "video_timestamp": 178,
      "tips": [
        {
          "text": "Raise your hand and pull it close to your body to release your wrist",
          "timestamp": 191
        },
        {
          "text": "Open your arm inside out and cover the back of the hand of your opponent",
          "timestamp": 195
        },
        {
          "text": "Be careful not to let your elbow rise excessively or move outward",
          "timestamp": 202
        },
        {
          "text": "You can only exert force effectively when the elbow is close to the torso",
          "timestamp": 207
        },
        {
          "text": "When performing Jeocheonaegi, pull the hand close to the body and release the wrist",
          "timestamp": 341
        }
      ]
    },
    {
      "key": "03",
      "name": {
        "en": "Diamond Inner-wrist Outward Block",
        "ko": "금강 안팔목바깥막기",
        "romanized": "Geumgang Anpalmok Bakkat Makgi"
      },
      "category": "block",
      "video_timestamp": 213,
      "tips": [
        {
          "text": "The outer arm performs Ulgulmakgi while the inner arm performs Anpalmok Bakkanmakgi at the same time",
          "timestamp": 220
        },
        {
          "text": "The hammer fist being pulled must not touch the front of the opposite shoulder",
          "timestamp": 453
        },
        {
          "text": "Pull the left foot to the inside of the right knee",
          "timestamp": 458
        },
        {
          "text": "Move your center to the right foot, then complete Hakdariseogi Jageun Doljjeogwi",
          "timestamp": 462
        },
        {
          "text": "Leave the right fist on the back in the Jageun Doljjeogwi posture",
          "timestamp": 476
        },
        {
          "text": "The left fist should start from the waist and draw a circle inside out to perform the Yeopchagi",
          "timestamp": 480
        }
      ]
    },
    {
      "key": "04",
      "name": {
        "en": "Pulling/Sweeping Block",
        "ko": "메뚜러빼기",
        "romanized": "Metteureo Ppaegi"
      },
      "category": "block",
      "video_timestamp": 230,
      "tips": [
        {
          "text": "Teureoppaegi is a technique where you spin the thumb toward the inner wrist",
          "timestamp": 232
        },
        {
          "text": "Release between an opponent's thumb and index finger",
          "timestamp": 236
        },
        {
          "text": "When performing Meteuro Ppaegi, you must move and set the left foot to the left",
          "timestamp": 621
        },
        {
          "text": "Twist the body to the opposite direction of progress, then perform Oen Apgubi",
          "timestamp": 624
        },
        {
          "text": "Open your hand with a space of one raised fist",
          "timestamp": 632
        },
        {
          "text": "Open your right hand and pull the back of your hand to the right back",
          "timestamp": 636
        },
        {
          "text": "Ppaegi must be performed quickly",
          "timestamp": 643
        },
        {
          "text": "Use your arm and weight together to finish the move",
          "timestamp": 644
        }
      ]
    },
    {
      "key": "05",
      "name": {
        "en": "Back-fist High Outward Strike",
        "ko": "등주먹 얼굴바깥치기",
        "romanized": "Deungjumeok Ulgul Bakkat Chigi"
      },
      "category": "strike",
      "video_timestamp": 241,
      "tips": [
        {
          "text": "The elbow should face downward and the fist raised level with the temple",
          "timestamp": 251
        },
        {
          "text": "The hand blade should be level with the solar plexus",
          "timestamp": 575
        },
        {
          "text": "The elbow should point downward",
          "timestamp": 578
        },
        {
          "text": "The elbow of the blocking arm should maintain 90 to 120 degrees",
          "timestamp": 581
        },
        {
          "text": "The assisting left hand should be level with the right elbow",
          "timestamp": 586
        },
        {
          "text": "Keep the left elbow close to the body",
          "timestamp": 591
        },
        {
          "text": "Leave one hand length between the outer wrist and torso",
          "timestamp": 595
        },
        {
          "text": "Keep the index, middle and ring finger in a straight line at the same length to prevent injuries",
          "timestamp": 604
        },
        {
          "text": "The force is concentrated in the tip of the hand with a small area of contact, making it effective in attacking pressure points",
          "timestamp": 610
        },
        {
          "text": "Push off the ground with the left foot, move your center to the right foot",
          "timestamp": 648
        },
        {
          "text": "Spin with the right ball as an axis, then perform Deungjumeok Bakkanchigi",
          "timestamp": 652
        }
      ]
    },
