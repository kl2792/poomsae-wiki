    {
      "key": "bull-block",
      "name": {
        "en": "Bull Block",
        "ko": "황소막기",
        "romanized": "Hwangsomakgi"
      },
      "category": "block",
      "video_timestamp": 244,
      "video_timestamp_end": 297,
      "tips": [
        {
          "text": "Twist your wrist so that the back of the fist faces downward at the lower abdomen",
          "timestamp": 249
        },
        {
          "text": "Raise your fists up to your face, then snap your elbow to block upward",
          "timestamp": 254
        },
        {
          "text": "When blocking, the fist should be placed obliquely above the elbow",
          "timestamp": 261
        },
        {
          "text": "The space between the back of the wrist and forehead should be about one raised fist's length",
          "timestamp": 267
        },
        {
          "text": "The distance between the fists should be the same",
          "timestamp": 273
        },
        {
          "text": "Close both your elbows and chest to stabilize the shoulders and shoulder blades",
          "timestamp": 278
        },
        {
          "text": "Keep the arms that performed Hwangsomakgi firm",
          "timestamp": 284
        },
        {
          "text": "Be mindful not to let your elbow open backwards",
          "timestamp": 291
        }
      ]
    },
    {
      "key": "palm-assisted-outer-block",
      "name": {
        "en": "Palm-Assisted Outer Block",
        "ko": "손바닥거들어바깥막기",
        "romanized": "Sonbadak Geodeureo Bakkanmakgi"
      },
      "category": "block",
      "video_timestamp": 298,
      "video_timestamp_end": 337,
      "tips": [
        {
          "text": "The tip of the middle finger of the opposite hand starts at the wrist of the blocking arm",
          "timestamp": 316
        },
        {
          "text": "Both elbows should face downward and the armpits should be touching the body",
          "timestamp": 326
        },
        {
          "text": "The armpit of the assisting arm should not be away from the body",
          "timestamp": 333
        }
      ]
    },
    {
      "key": "flat-fingertip-upset-thrust",
      "name": {
        "en": "Flat Fingertip Upset Thrust",
        "ko": "편손끝엎어지르기",
        "romanized": "Pyeonsonkeut Eopeojjireugi"
      },
      "category": "strike",
      "video_timestamp": 338,
      "video_timestamp_end": 387,
      "tips": [
        {
          "text": "Be careful to keep the four fingers aligned",
          "timestamp": 366
        },
        {
          "text": "Be careful not to let the elbow open outside in order to perform Eopeojjireugi accurately",
          "timestamp": 381
        }
      ]
    },
    {
      "key": "rock-pushing",
      "name": {
        "en": "Rock Pushing",
        "ko": "바위밀기",
        "romanized": "Bawimilgi"
      },
      "category": "combination",
      "video_timestamp": 388,
      "video_timestamp_end": 459,
      "tips": [
        {
          "text": "Your left arm is placed obliquely with the space of one hand span",
          "timestamp": 413
        },
        {
          "text": "Your right hand is symmetrically placed slightly below your left hand with a one fist space between",
          "timestamp": 421
        },
        {
          "text": "Exert force while you tighten the elbows and straighten the body",
          "timestamp": 433
        },
        {
          "text": "The elbows should not open backwards, the torso must not tilt to one side",
          "timestamp": 447
        },
        {
          "text": "The wrist and elbow should not be straight when the move is completed",
          "timestamp": 454
        }
      ]
    },
    {
      "key": "knifehand-edge-spreading-block",
      "name": {
        "en": "Knifehand Edge Spreading Block",
        "ko": "손날등헤쳐막기",
        "romanized": "Sonaldeung Hecheomakgi"
      },
      "category": "block",
      "video_timestamp": 460,
      "video_timestamp_end": 502,
      "tips": [
        {
          "text": "You can use the back of the hand blade to strike and block, absorb and block, and wind and grab an opponent's arm",
          "timestamp": 472
        },
        {
          "text": "Your elbow should face downward and your armpit should lightly touch the body",
          "timestamp": 481
        },
        {
          "text": "Your armpit should not open due to your elbow rising or moving far away from the body",
          "timestamp": 492
        },
        {
          "text": "The back of your hand blade must go outside the shoulder line",
          "timestamp": 498
        }
      ]
    },
    {
      "key": "pulling-block",
      "name": {
        "en": "Pulling Block",
        "ko": "끌어올리기",
        "romanized": "Kkeureooligi"
      },
      "category": "block",
      "video_timestamp": 503,
      "video_timestamp_end": 568,
      "tips": [
        {
          "text": "The arm performing Kkeureooligi comes near the body from below",
          "timestamp": 515
        },
        {
          "text": "The wrist is then twisted so the inner wrist faces upward, then the back of it is snapped to block",
          "timestamp": 519
        },
        {
          "text": "The arm is not the only part used to perform this move",
          "timestamp": 525
        },
        {
          "text": "The flexible movement of the arm and back must also be in harmony",
          "timestamp": 529
        },
        {
          "text": "The opposite arm is pulled to the back at the same speed and force",
          "timestamp": 534
        },
        {
          "text": "The upper body must be flexible and the lower body must stand firm",
          "timestamp": 539
        },
        {
          "text": "The wrist should cross the center line and the space between the torso and arm should be about one raised fist's length",
          "timestamp": 546
        },
        {
          "text": "Be careful not to let the arm performing Kkeureooligi pass the waist and fall back, then pull up",
          "timestamp": 559
        }
      ]
    },
    {
      "key": "scissor-punch",
      "name": {
        "en": "Scissor Punch",
        "ko": "쳇다리지르기",
        "romanized": "Chetdarijireugi"
      },
      "category": "strike",
      "video_timestamp": 569,
      "video_timestamp_end": 609,
      "tips": [
        {
          "text": "Maintain a space of about two fists' length between the fists and thrust at the solar plexus level",
          "timestamp": 579
        },
        {
          "text": "Your arms should be parallel",
          "timestamp": 585
        },
        {
          "text": "The fist in the back should be placed on the wrist of the other arm in Apgubi",
          "timestamp": 589
        },
        {
          "text": "Placed on the elbow in Dwitgubi",
          "timestamp": 595
        },
        {
          "text": "The elevation of the two arms must be identical and the fists should not be placed apart too wide or narrow",
          "timestamp": 600
        },
        {
          "text": "Maintaining a space of about two fists' length between them",
          "timestamp": 606
        }
      ]
    },
    {
      "key": "open-hand-cross-low-block",
      "name": {
        "en": "Open Hand Cross Low Block",
        "ko": "편손엇걸어아래막기",
