  "techniques": [
    {
      "key": "bull-block",
      "name": {
        "en": "Bull Block",
        "ko": "기본 준비자세",
        "romanized": "Hwangsomakgi"
      },
      "category": "block",
      "video_timestamp": 242,
      "tips": [
        {
          "text": "Twist your wrist so that the back of the fist faces downward at the lower abdomen.",
          "timestamp": 246.9,
          "source": "caption"
        },
        {
          "text": "Raise your fists up to your face, then snap your elbow to block upward.",
          "timestamp": 252.9,
          "source": "caption"
        },
        {
          "text": "When blocking, the fist should be placed obliquely above the elbow.",
          "timestamp": 258.9,
          "source": "caption"
        },
        {
          "text": "The space between the back of the wrist and forehead should be about one raised fist length.",
          "timestamp": 264.9,
          "source": "caption"
        },
        {
          "text": "The distance between the fists should be the same.",
          "timestamp": 270.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 297
    },
    {
      "key": "palm-augmented-outward-block",
      "name": {
        "en": "Palm Augmented Outward Block",
        "ko": "손날몸통바깥막기",
        "romanized": "Sonbadak Geodeureo Bakkanmakgi"
      },
      "category": "block",
      "video_timestamp": 297,
      "tips": [
        {
          "text": "by placing the whole palm of the other hand on the outer wrist.",
          "timestamp": 301.9,
          "source": "caption"
        },
        {
          "text": "This technique is typically used to perform a strong block with assistance from one arm against a strong attack,",
          "timestamp": 305.9,
          "source": "caption"
        },
        {
          "text": "then quickly connect to the next move.",
          "timestamp": 312.9,
          "source": "caption"
        },
        {
          "text": "The tip of the middle finger of the opposite hand starts at the wrist of the blocking arm.",
          "timestamp": 315.9,
          "source": "caption"
        },
        {
          "text": "Next, gather all your fingers and attach them to the outer wrist.",
          "timestamp": 321.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 338
    },
    {
      "key": "flat-fingertip-thrust",
      "name": {
        "en": "Flat Fingertip Thrust",
        "ko": "제비품안치기",
        "romanized": "Pyeonsonkeut Eopeojjireugi"
      },
      "category": "strike",
      "video_timestamp": 338,
      "tips": [
        {
          "text": "by gathering the four fingers straight with the palm facing downward.",
          "timestamp": 346.9,
          "source": "caption"
        },
        {
          "text": "You can attack a pressure point with a strong force as the contact surface of the target becomes smaller",
          "timestamp": 351.9,
          "source": "caption"
        },
        {
          "text": "when struck with your gathered four fingers.",
          "timestamp": 357.9,
          "source": "caption"
        },
        {
          "text": "This move transfers a strong force.",
          "timestamp": 362.9,
          "source": "caption"
        },
        {
          "text": "Be careful to keep the four fingers aligned to avoid injuries to the finger joints.",
          "timestamp": 365.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 388
    },
    {
      "key": "rock-pushing",
      "name": {
        "en": "Rock Pushing",
        "ko": "(몸통)안막기",
        "romanized": "Bawimilgi"
      },
      "category": "strike",
      "video_timestamp": 388,
      "tips": [
        {
          "text": "then push in a straight line using your palms.",
          "timestamp": 398.9,
          "source": "caption"
        },
        {
          "text": "Bend the wrists naturally and keep your thumb close to your hand.",
          "timestamp": 406.9,
          "source": "caption"
        },
        {
          "text": "Your left arm is placed obliquely with a space of one hand span between the back of your hand and forehead.",
          "timestamp": 411.9,
          "source": "caption"
        },
        {
          "text": "Your right hand is symmetrically placed slightly below your left hand with a one-fist space between.",
          "timestamp": 419.9,
          "source": "caption"
        },
        {
          "text": "Opening the elbow weakens the shoulder, so exert force while you tighten the elbows and straighten the body.",
          "timestamp": 428.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 460
    },
    {
      "key": "reverse-knifehand-spreading-block",
      "name": {
        "en": "Reverse Knifehand Spreading Block",
        "ko": "올려(얼굴)막기",
        "romanized": "Sonaldeung Hecheomakgi"
      },
      "category": "block",
      "video_timestamp": 460,
      "tips": [
        {
          "text": "You can use the back of the hand blade to strike and block, absorb and block, and wind and grab an opponent's arm.",
          "timestamp": 467.9,
          "source": "caption"
        },
        {
          "text": "Your elbow should face downward, and your armpit should lightly touch the body.",
          "timestamp": 476.9,
          "source": "caption"
        },
        {
          "text": "The tip of your hand must not rise above your shoulder.",
          "timestamp": 483.9,
          "source": "caption"
        },
        {
          "text": "Your armpit should not open due to your elbow rising or moving far away from the body.",
          "timestamp": 487.9,
          "source": "caption"
        },
        {
          "text": "The back of your hand blade must go outside the shoulder line.",
          "timestamp": 493.9,
          "source": "caption"
        }
      ],
      "video_timestamp_end": 520
    },
