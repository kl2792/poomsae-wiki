    {
      "key": "knifehand-high-rising-block",
      "name": {
        "en": "Knifehand High Rising Block",
        "ko": "손날 얼굴(올려)막기",
        "romanized": "Sonal Ulgul(Ollyeo)Makgi"
      },
      "category": "block",
      "video_timestamp": 168,
      "video_timestamp_end": 231,
      "tips": [
        {
          "text": "Cross the arms so the blocking arm is outside to block the face",
          "timestamp": 175
        },
        {
          "text": "The hand of the blocking arm rises first",
          "timestamp": 182
        },
        {
          "text": "Raise the hand first at face elevation and snap the elbow upward to block",
          "timestamp": 184
        },
        {
          "text": "Pull the opposite fist to the back",
          "timestamp": 189
        },
        {
          "text": "The space between the blocking arm and forehead should be about one fist",
          "timestamp": 199
        },
        {
          "text": "Tilt the arm so that the fist faces upward and the elbow faces downward",
          "timestamp": 205
        },
        {
          "text": "Be careful not to let the elbow of the blocking arm open backwards as this will weaken the arm",
          "timestamp": 212
        },
        {
          "text": "The elbow must not raise first to block",
          "timestamp": 221
        },
        {
          "text": "Be careful not to let the blocking arm rise above the head",
          "timestamp": 225
        }
      ]
    },
